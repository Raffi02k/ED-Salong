# Server-only configuration. Never copy secrets into frontend/.env.local.
CONTACT_MODE=demo
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_SECONDS=600
MAX_BODY_BYTES=16384
# Set CONTACT_MODE=smtp after setting every required SMTP field.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
# SMTP always uses TLS (STARTTLS on 587, SSL on 465).
SMTP_SSL=false
